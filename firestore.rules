rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'hmpark014@gmail.com';
    }
    function editorPermissionPath(uid) {
      return /databases/$(database)/documents/editorPermissions/$(uid);
    }
    function canManageEditRestrictions() {
      return isAdmin() || (signedIn()
        && exists(editorPermissionPath(request.auth.uid))
        && get(editorPermissionPath(request.auth.uid)).data.canManageRestrictions == true);
    }
    function canApproveEditRequests() {
      return isAdmin() || (signedIn()
        && exists(editorPermissionPath(request.auth.uid))
        && get(editorPermissionPath(request.auth.uid)).data.canApproveEditRequests == true);
    }
    function approvedEditProposalMatches(docId, data) {
      let proposalPath = /databases/$(database)/documents/editRequests/$(data.approvedEditRequestId);
      return data.approvedEditRequestId is string
        && existsAfter(proposalPath)
        && getAfter(proposalPath).data.status == 'approved'
        && getAfter(proposalPath).data.docId == docId
        && getAfter(proposalPath).data.reviewedBy == request.auth.uid
        && getAfter(proposalPath).data.title == data.title
        && getAfter(proposalPath).data.category == data.category
        && getAfter(proposalPath).data.summary == data.summary
        && getAfter(proposalPath).data.body == data.body
        && getAfter(proposalPath).data.images == data.images
        && getAfter(proposalPath).data.videos == data.videos;
    }
    function approvedProposalApplied(requestData, requestId) {
      let documentPath = /databases/$(database)/documents/docs/$(requestData.docId);
      return existsAfter(documentPath)
        && getAfter(documentPath).data.approvedEditRequestId == requestId
        && getAfter(documentPath).data.title == requestData.title
        && getAfter(documentPath).data.category == requestData.category
        && getAfter(documentPath).data.summary == requestData.summary
        && getAfter(documentPath).data.body == requestData.body
        && getAfter(documentPath).data.images == requestData.images
        && getAfter(documentPath).data.videos == requestData.videos;
    }
    function withinDefaultLimits(data) {
      return data.body is string
        && data.body.size() <= 18000
        && (!('images' in data) || (data.images is list && data.images.size() <= 2))
        && (!('videos' in data) || (data.videos is list && data.videos.size() <= 0));
    }

    match /docs/{docId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create: if signedIn()
        && request.resource.data.status == 'published'
        && (isAdmin() || (request.resource.data.authorUid == request.auth.uid
          && request.resource.data.editRestricted == false
          && withinDefaultLimits(request.resource.data)));
      allow update: if isAdmin()
        || (signedIn()
          && (!('editRestricted' in resource.data) || resource.data.editRestricted != true)
          && request.resource.data.editRestricted != true
          && request.resource.data.status == 'published'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'summary', 'body', 'images', 'videos', 'editRestricted', 'authorUid', 'updatedAt', 'updatedBy'])
          && (!('authorUid' in resource.data) || request.resource.data.authorUid == resource.data.authorUid)
          && withinDefaultLimits(request.resource.data))
        || (canManageEditRestrictions()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editRestricted', 'updatedAt', 'updatedBy'])
          && request.resource.data.editRestricted is bool)
        || (signedIn()
          && resource.data.editRestricted == true
          && request.resource.data.editRestricted == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'summary', 'body', 'images', 'videos', 'editRestricted', 'approvedEditRequestId', 'updatedAt', 'updatedBy'])
          && withinDefaultLimits(request.resource.data)
          && canApproveEditRequests()
          && approvedEditProposalMatches(docId, request.resource.data));
      allow delete: if isAdmin();
    }

    match /userProfiles/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /editorPermissions/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if isAdmin()
        && request.resource.data.uid == userId
        && request.resource.data.canApproveEditRequests == true
        && request.resource.data.canManageRestrictions == true
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'canApproveEditRequests', 'canManageRestrictions', 'grantedBy', 'grantedAt']);
      allow delete: if isAdmin();
    }

    match /editRequests/{requestId} {
      allow read: if isAdmin() || canApproveEditRequests()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['docId', 'title', 'category', 'summary', 'body', 'images', 'videos', 'author', 'ownerUid', 'status', 'chars', 'imageCount', 'videoCount', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.docId is string
        && exists(/databases/$(database)/documents/docs/$(request.resource.data.docId))
        && get(/databases/$(database)/documents/docs/$(request.resource.data.docId)).data.editRestricted == true
        && request.resource.data.title is string
        && request.resource.data.category is string
        && request.resource.data.summary is string
        && request.resource.data.body is string
        && request.resource.data.images is list
        && request.resource.data.videos is list
        && request.resource.data.author is string
        && request.resource.data.chars is int
        && request.resource.data.imageCount is int
        && request.resource.data.videoCount is int
        && withinDefaultLimits(request.resource.data);
      allow update: if canApproveEditRequests()
        && (isAdmin() || resource.data.ownerUid != request.auth.uid)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.status in ['approved', 'rejected']
        && (request.resource.data.status == 'rejected'
          || approvedProposalApplied(resource.data, requestId));
      allow delete: if isAdmin();
    }

    match /limitRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 180000
        && request.resource.data.mediaImages is list
        && request.resource.data.mediaImages.size() <= 20
        && request.resource.data.mediaVideos is list
        && request.resource.data.mediaVideos.size() <= 10;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.docId is string
        && request.resource.data.docId.size() <= 200
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 1500
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /searches/{searchId} {
      allow read: if true;
      allow create: if searchId.size() <= 1000
        && request.resource.data.keys().hasOnly(['term', 'day', 'count', 'updatedAt'])
        && request.resource.data.count is int
        && request.resource.data.count == 1
        && request.resource.data.term is string
        && request.resource.data.term.size() <= 300
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10;
      allow update: if request.resource.data.keys().hasOnly(['term', 'day', 'count', 'updatedAt'])
        && request.resource.data.count is int
        && request.resource.data.term == resource.data.term
        && request.resource.data.day == resource.data.day
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /changes/{changeId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['docId', 'title', 'kind', 'author', 'authorUid', 'updatedAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.docId is string
        && request.resource.data.docId.size() <= 256
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.kind in ['new', 'edit', 'delete', 'move', 'rollback', 'restore', 'copy']
        && request.resource.data.author is string
        && request.resource.data.updatedAt is timestamp;
      allow update, delete: if isAdmin();
    }

    match /discussions/{discussionId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'docId', 'docTitle', 'title', 'body', 'author', 'authorUid', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.kind in ['discussion', 'board']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 6000
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 240
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!('docId' in request.resource.data) || request.resource.data.docId == null || (request.resource.data.docId is string && request.resource.data.docId.size() <= 256));
      allow update: if isAdmin()
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt is timestamp)
        || (signedIn() && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['open', 'paused', 'closed']
          && request.resource.data.updatedAt is timestamp);
      allow delete: if isAdmin();
    }

    match /discussionComments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['discussionId', 'body', 'author', 'authorUid', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.discussionId is string
        && request.resource.data.discussionId.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 240
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isAdmin();
    }
  }
}
